# Copie para .env (que está no .gitignore) e preencha. Nunca commite valores reais.
# O Spring não lê .env sozinho: exporte as variáveis no shell, no Docker (--env-file) ou no painel do host.

# --- Obrigatórias ---
# Segredo de assinatura dos tokens (mínimo 32 caracteres). Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
# Chave da API da OpenAI (platform.openai.com)
OPENAI_API_KEY=sk-troque-por-sua-chave

# --- Produção (SPRING_PROFILES_ACTIVE=prod) ---
SPRING_PROFILES_ACTIVE=prod
# Use sslmode=require (ou verify-full) para a conexão ser cifrada
DATABASE_URL=jdbc:postgresql://HOST:5432/margem?sslmode=require
DATABASE_USER=margem_app
DATABASE_PASSWORD=troque-pela-senha-do-banco
# Primeira subida com um usuário que possa criar tabelas: DDL_AUTO=update. Depois volte para validate.
DDL_AUTO=validate

# --- Opcionais ---
MARGEM_CORS=https://seu-front.vercel.app
JWT_EMISSOR=margem-api
JWT_AUDIENCIA=margem-front
JWT_ACCESS_TTL=PT10M
JWT_REFRESH_TTL=P14D
# Front e API em sites diferentes: None (exige HTTPS). Mesmo site: Lax.
COOKIE_SAMESITE=None
COOKIE_SECURE=true
# Atrás de proxy/load balancer, "native" para o limite de requisições enxergar o IP real
FORWARD_HEADERS=native
# Swagger fica desligado em produção; ligue só em ambiente fechado
MARGEM_SWAGGER=false
OPENAI_MODEL=gpt-4.1
